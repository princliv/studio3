# Backend API base URL used by the Flutter app (lib/config/api_config.dart).
# Uncomment ONE of the two NEXT_PUBLIC_API_URL lines below and comment out
# the other to switch — just hot restart the app, no rebuild needed.

# Local dev backend.
#   Android emulator: use 10.0.2.2 (not localhost)
# NEXT_PUBLIC_API_URL=http://10.0.2.2:9000
#   iOS Simulator / web: localhost is fine
#   Physical device: use your PC's LAN IP instead, e.g. http://10.202.105.236:9000
# NEXT_PUBLIC_API_URL=http://localhost:9000

# Deployed/test backend
NEXT_PUBLIC_API_URL=https://studio3-backend.onrender.com

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_OAUTH_CALLBACK_PATH=/auth/callback

# Optional
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=